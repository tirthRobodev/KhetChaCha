# ==========================================
# KhetChacha Farmer AI Engine Configuration
# ==========================================

# 1. Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Configurable Gemini Models:
# Primary model for response generation (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Multilingual embedding model for knowledge base vector store
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Timeout and retry configuration
GEMINI_REQUEST_TIMEOUT_SECONDS=20.0
GEMINI_MAX_RETRIES=3

# 2. Search Engine Configuration
# Enable online web research when local knowledge base lacks sufficient confidence
ONLINE_SEARCH_ENABLED=true

# Search Provider: "gemini_grounding" (Google Search tool), "configurable_web" (DuckDuckGo/web), or "mock"
ONLINE_SEARCH_PROVIDER=gemini_grounding
ONLINE_SEARCH_TIMEOUT_SECONDS=8.0

# Minimum score threshold for local PDF evidence acceptance (0.0 to 1.0)
LOCAL_SEARCH_MIN_SCORE=0.35

# 3. Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

